# ============================================================================
# POS ERP v6 — Environment Configuration
# Copy this file to .env and fill in real values before running.
# ============================================================================

# ── Application ─────────────────────────────────────────────────────────────
# Runtime environment: "local", "development", "staging", or "production"
POS_ERP_ENV=local

# Server bind host and port (used by uvicorn / systemd service)
APP_HOST=0.0.0.0
APP_PORT=8000

# Enable debug mode (set to "false" in production)
APP_DEBUG=true

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Branch identifier for multi-branch deployments
# BRANCH_ID=branch-001

# ── Database (PostgreSQL) ───────────────────────────────────────────────────
# Option A: Full connection URL (takes precedence over individual vars below)
# POS_ERP_DATABASE_URL=postgresql://pos_erp:change-me@localhost:5432/pos_erp

# Option B: Individual connection parameters (used to build URL if Option A is unset)
POSTGRES_USER=pos_erp
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pos_erp

# SSL mode for PostgreSQL: disable, allow, prefer, require, verify-ca, verify-full
# PG_SSLMODE=prefer

# ── JWT / Authentication ────────────────────────────────────────────────────
# Secret key used to sign JWT-like access tokens (HMAC-SHA256).
# MUST be changed to a strong random string in production.
POS_ERP_SECRET_KEY=dev-only-change-me

# JWT algorithm (currently hardcoded to HS256; documented for reference)
# JWT_ALGORITHM=HS256

# Access token expiry in seconds (default: 86400 = 24 hours)
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Refresh token expiry in days
# JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── API Server / CORS ───────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins. Use "*" for development only.
CORS_ORIGINS=*

# ── ERP Integration ─────────────────────────────────────────────────────────
# Base URL of the upstream ERP system (for sync / data exchange)
POS_ERP_ERP_BASE_URL=https://erp.beautynshine.web.id

# API key for authenticating with the ERP system
# ERP_API_KEY=change-me

# ── Sync Configuration ──────────────────────────────────────────────────────
# How often (in seconds) to check for sync updates
# SYNC_INTERVAL_SECONDS=60

# Maximum number of retry attempts for failed sync operations
# SYNC_MAX_RETRIES=3

# ── Payment — Webhook Verification ──────────────────────────────────────────
# Shared secret for verifying incoming payment webhook signatures
POS_ERP_PAYMENT_WEBHOOK_SECRET=change-me

# ── Payment — Midtrans ──────────────────────────────────────────────────────
# Midtrans merchant ID (from Midtrans dashboard)
# MIDTRANS_MERCHANT_ID=

# Midtrans client key (safe for frontend / Snap)
MIDTRANS_CLIENT_KEY=change-me

# Midtrans server key (secret — used server-side only)
MIDTRANS_SERVER_KEY=change-me

# Midtrans API base URL (sandbox or production)
# MIDTRANS_API_URL=https://app.sandbox.midtrans.com

# ── Payment — BCA Virtual Account ───────────────────────────────────────────
# BCA VA merchant ID
# BCA_VA_MERCHANT_ID=

# BCA API client ID (for OAuth)
BCA_CLIENT_ID=change-me

# BCA API client secret (secret — used server-side only)
BCA_CLIENT_SECRET=change-me

# BCA VA API key
# BCA_VA_API_KEY=

# BCA VA secret key
# BCA_VA_SECRET_KEY=

# BCA API base URL (sandbox or production)
# BCA_API_URL=https://sandbox.bca.co.id

# ── Security ────────────────────────────────────────────────────────────────
# Encryption key for sensitive data at rest (hex-encoded, 32 bytes recommended)
# ENCRYPTION_KEY=change-me-to-random-32-bytes-hex

# HMAC secret for data integrity verification
# HMAC_SECRET=change-me

# Rate limiting: max requests per window per client IP
# RATE_LIMIT_REQUESTS=60

# Rate limiting: window duration in seconds
# RATE_LIMIT_WINDOW_SECONDS=60

# Staff screen lock timeout in minutes
# STAFF_LOCK_TIMEOUT_MINUTES=10

# ── Cloudflare Tunnel ───────────────────────────────────────────────────────
# Token for cloudflared tunnel (from Zero Trust dashboard).
# Used with: cloudflared tunnel run --token $CLOUDFLARE_TUNNEL_TOKEN
# CLOUDFLARE_TUNNEL_TOKEN=

# =============================================================================
# POS-ERP Integration Engine V6 — Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================================

# --- Application -------------------------------------------------------------
POS_ERP_ENV=development                     # development | testing | production
POS_ERP_SECRET_KEY=change-me-to-a-random-string  # Used for signing tokens & sessions

# --- Database ----------------------------------------------------------------
# Async connection string (used by the application)
POS_ERP_DATABASE_URL=postgresql+asyncpg://pos_erp:pos_erp@localhost:5432/pos_erp

# PostgreSQL container settings (used by docker-compose)
POSTGRES_DB=pos_erp
POSTGRES_USER=pos_erp
POSTGRES_PASSWORD=pos_erp

# --- Payment: Midtrans -------------------------------------------------------
MIDTRANS_SERVER_KEY=                        # Midtrans server key (sandbox or production)
MIDTRANS_MERCHANT_ID=                       # Midtrans merchant ID

# --- Payment: BCA Virtual Account -------------------------------------------
BCA_CLIENT_ID=                              # BCA API client ID
BCA_CLIENT_SECRET=                          # BCA API client secret
BCA_COMPANY_CODE=                           # BCA company/merchant code
BCA_CHANNEL_ID=                             # BCA channel identifier
